# Copy this file to ".env" and fill in the real values.
# Never commit the real ".env" file — it stays out of git (see .gitignore).

# Required — the app will not start without this
OPENAI_API_KEY=

# Which OpenAI model does what (can change later without touching code)
PRIMARY_LLM=gpt-4.1
ORCHESTRATOR_MODEL=gpt-4.1-mini

# Embedding model used for search
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Web server
API_HOST=0.0.0.0
API_PORT=8001

# Redis (permission cache) — defaults match a local Docker container
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_DB=0

# Milvus (document vector search) — defaults to the Docker standalone
# stack; browse it visually via Attu at http://localhost:3000. Point
# this at a local file path instead (e.g. data/vector_store/milvus.db)
# to fall back to container-free Milvus Lite.
MILVUS_URI=http://localhost:19530

# Real SyteLine WebClient demo credentials, for connectivity/integration
# testing only — leave blank here, fill real values only in your own .env
SYTELINE_LOGIN_URL=
SYTELINE_CONFIGURATION_NAME=
SYTELINE_USERNAME=
SYTELINE_PASSWORD=
