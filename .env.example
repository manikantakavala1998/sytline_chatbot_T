# Copy this file to ".env" and fill in the real values.
# Never commit the real ".env" file — it stays out of git (see .gitignore).

# Required — the app will not start without this
OPENAI_API_KEY=

# Which OpenAI model does what (can change later without touching code)
PRIMARY_LLM=gpt-4.1
ORCHESTRATOR_MODEL=gpt-4.1-mini
ORCHESTRATOR_LLM_ENABLED=true
ORCHESTRATOR_TIMEOUT_SECONDS=12
# Phase 5 hallucination guard — check every generated answer against its documents
ANSWER_VALIDATION_ENABLED=true
ANSWER_VALIDATION_MODEL=gpt-4.1
# Phase 5 escalation — tickets and security events are stored in Postgres; "log" = log the
# notification only (email/Teams notifiers plug in later). Alert after N blocks in the window.
ESCALATION_NOTIFIER=log
SECURITY_ALERT_THRESHOLD=3
SECURITY_ALERT_WINDOW_MINUTES=15

# Outlook / Microsoft 365 ticket mail — set ESCALATION_NOTIFIER=outlook to turn it on.
# The feedback console (/admin.html) shows which values are still missing and has a
# "Send test email" button. Restart the server after changing these.
OUTLOOK_SEND_METHOD=graph
# Mailbox the bot sends from:
OUTLOOK_SENDER=
# Where new tickets go (comma-separated for several):
SUPPORT_TICKET_EMAIL=
# Where security alerts go (leave empty to not email alerts):
SECURITY_ALERT_EMAIL=
# The feedback console address as support staff open it (adds an "Open in the feedback console"
# button to ticket and alert emails; empty = no button). Example: http://chatbot.company.local/admin.html
ADMIN_CONSOLE_URL=
# graph: Azure app registration with the Mail.Send application permission (ask IT to limit it
# to the sender mailbox with an application access policy).
OUTLOOK_TENANT_ID=
OUTLOOK_CLIENT_ID=
OUTLOOK_CLIENT_SECRET=
# smtp: only if IT allows SMTP AUTH for the sender mailbox.
OUTLOOK_SMTP_HOST=smtp.office365.com
OUTLOOK_SMTP_PORT=587
OUTLOOK_SMTP_USERNAME=
OUTLOOK_SMTP_PASSWORD=

# Logging — clear step-by-step trace in the terminal and logs/chatbot.log.
# Show question / answer / document text in the trace (secrets always masked). Use false in production.
LOG_CONVERSATION_TEXT=true
# trace = clear steps + warnings/errors in the terminal; all = also every technical event line
LOG_TERMINAL=trace

# Embedding model used for search
EMBEDDING_MODEL=BAAI/bge-base-en-v1.5

# Web server
API_HOST=0.0.0.0
API_PORT=8001

# Redis (permission cache) — this project's OWN dedicated container
# (docker-compose.yml service "redis" / ptc-redis), on a non-default
# port so it never collides with some other project's Redis on 6379.
REDIS_HOST=localhost
REDIS_PORT=6380
REDIS_DB=0

# Milvus (document vector search) — this project's OWN dedicated Docker
# stack (docker-compose.yml), on a non-default port for the same
# isolation reason as Redis above. Browse vectors visually via Attu at
# http://localhost:3001. Point this at a local file path instead (e.g.
# data/vector_store/milvus.db) to fall back to container-free Milvus Lite.
MILVUS_URI=http://localhost:19531

# PostgreSQL (conversation history) — this project's OWN container
# (docker-compose.yml service "postgres" / ptc-postgres) on port 5433.
# Values below are the local-dev container defaults; change them for any
# shared environment (docker-compose.yml reads the same variable names).
POSTGRES_HOST=localhost
POSTGRES_PORT=5433
POSTGRES_DB=ptc_chat
POSTGRES_USER=ptc
POSTGRES_PASSWORD=ptc_local_dev
HISTORY_TURNS_FOR_CONTEXT=3

# Real SyteLine WebClient demo credentials, for connectivity/integration
# testing only — leave blank here, fill real values only in your own .env
SYTELINE_LOGIN_URL=
SYTELINE_CONFIGURATION_NAME=
SYTELINE_USERNAME=
SYTELINE_PASSWORD=

# Phase 6 — audit trail (Postgres table audit_events, append-only)
AUDIT_RETENTION_DAYS=365
# Store the secret-masked question text / a 300-character answer preview in each audit row.
# Turn the preview off once live SyteLine data (Phase 4) can appear in answers.
AUDIT_STORE_QUESTION_TEXT=true
AUDIT_STORE_ANSWER_PREVIEW=true
# USD per 1 million tokens, for cost figures (JSON). Leave unset to use the built-in list prices.
# MODEL_PRICES={"gpt-4.1": {"input": 2.0, "output": 8.0}, "gpt-4.1-mini": {"input": 0.4, "output": 1.6}}

# Phase 6 — health alerts (checked every MONITOR_INTERVAL_SECONDS over the last ALERT_WINDOW_MINUTES)
MONITOR_INTERVAL_SECONDS=300
ALERT_WINDOW_MINUTES=15
ALERT_MIN_REQUESTS=10
ALERT_ERROR_RATE_PCT=5
ALERT_P95_LATENCY_SECONDS=25
ALERT_LLM_FALLBACK_RATE_PCT=20
ALERT_ANSWERED_PCT_MIN=60
ALERT_DAILY_COST_USD=10
# Where health alerts are emailed when ESCALATION_NOTIFIER=outlook; empty = log and console only
OPS_ALERT_EMAIL=
